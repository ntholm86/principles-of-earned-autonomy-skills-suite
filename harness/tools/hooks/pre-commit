#!/usr/bin/env python3
"""pre-commit hook - requires staged trail updates for project changes.

Any staged change outside .acm/, including deletion, requires an added or
modified repo- or task-scoped audit-trail.md. Evidence-only commits are allowed.
This checks staged paths, not entry truthfulness or append-only integrity.

Override with `git commit --no-verify`. This hook does not record overrides.

Install (run from the target repo root; the scripts live in the skills clone):
  bash <skills-repo>/harness/tools/install-hooks.sh        # macOS / Linux
  powershell -NoProfile -ExecutionPolicy Bypass -File <skills-repo>/harness/tools/install-hooks.ps1  # Windows
"""
from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

# Repo scope or a named task scope (.acm/<task>/audit-trail.md); see trail/SKILL.md.
TRAIL_LOG = re.compile(r"^\.acm/(?:[^/]+/)?audit-trail\.md$")


def staged_files(diff_filter: str = "") -> list[str]:
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "-z", "--no-renames",
         f"--diff-filter={diff_filter}"],
        capture_output=True, text=True, check=True,
    )
    return [path for path in out.stdout.split("\0") if path]


def main() -> int:
    files = staged_files()
    substantive = [path for path in files if not path.startswith(".acm/")]
    trail_staged = any(TRAIL_LOG.fullmatch(path) for path in staged_files("AM"))

    if substantive and not trail_staged:
        print("pre-commit: substantive changes staged without a .acm/audit-trail.md update.")
        print()
        print("Files touched:")
        for f in substantive:
            print(f"  - {f}")
        print()
        print("Observable Autonomy requires a trail entry for substantive changes.")
        print("Either:")
        print("  1. Append a structured entry to .acm/audit-trail.md (see trail/SKILL.md), or")
        print("  2. Override with: git commit --no-verify  (not recorded by this hook)")
        return 1

    repo_root = Path(subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True, text=True, check=True,
    ).stdout.strip())
    verify = repo_root / "verify.py"
    if verify.exists():
        result = subprocess.run([sys.executable, str(verify)], cwd=str(repo_root))
        if result.returncode != 0:
            print()
            print("pre-commit: verify.py failed. Fix the issues above or override with --no-verify.")
            return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
